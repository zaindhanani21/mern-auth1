{
  "manifest_version": 3,
  "name": "Wallexa One-Tap Checkout",
  "version": "1.0",
  "description": "Secure One-Tap Checkout Extension for Wallexa Wallet",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
 "hostPermissions": [
  "https://mern-auth1-flame.vercel.app/*",
  "https://mern-auth1-qnmh.onrender.com/*"
],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}