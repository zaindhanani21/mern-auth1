{
  "manifest_version": 3,
  "name": "Wallexa One-Tap Checkout",
  "version": "1.0",
  "description": "Secure One-Tap Checkout Extension for Wallexa Wallet",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "hostPermissions": [
    "http://192.168.43.54:5173/*",
    "http://192.168.43.54:5000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}